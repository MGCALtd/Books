{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Book research — local MCP and search page",
      "type": "debugpy",
      "request": "launch",
      "module": "book_research.cli",
      "args": ["--db", "data/pilot.sqlite3", "--cpu-embed", "serve", "--transport", "streamable-http", "--port", "8765"],
      "cwd": "${workspaceFolder}",
      "env": {
        "HF_HOME": "${workspaceFolder}/data/hf-home",
        "HF_XET_CACHE": "${workspaceFolder}/data/hf-xet",
        "HF_HUB_DISABLE_XET": "1"
      },
      "console": "integratedTerminal"
    }
  ]
}
